# ── Database ─────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/eksamadhan
DB_USERNAME=eksamadhan
DB_PASSWORD=change_me

# ── Meta (Facebook / Instagram) ───────────────────────────
FACEBOOK_APP_ID=your_id_here
FACEBOOK_APP_SECRET=your_secret_here
FACEBOOK_REDIRECT_URI=http://localhost:8080/api/auth/facebook/callback
INSTAGRAM_REDIRECT_URI=http://localhost:8080/api/auth/instagram/callback
WEBHOOK_VERIFY_TOKEN=eksamadhan_verify_token

# ── Meta proxy (stable public URL — see meta-proxy/) ─────
# Meta requires one fixed URL, but the Pinggy tunnel changes every restart.
PROXY_URL=https://your-proxy.vercel.app
PROXY_AUTH_TOKEN=change_me

# ── Frontend ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:5174


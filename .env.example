# ── Database ─────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/eksamadhan
DB_USERNAME=eksamadhan
DB_PASSWORD=change_me

# ── Meta (Facebook / Instagram) ───────────────────────────
FACEBOOK_APP_ID=your_id_here
FACEBOOK_APP_SECRET=your_secret_here
FACEBOOK_REDIRECT_URI=http://localhost:8080/api/auth/facebook/callback
INSTAGRAM_REDIRECT_URI=http://localhost:8080/api/auth/instagram/callback
WEBHOOK_VERIFY_TOKEN=eksamadhan_verify_token

# ── Meta proxy (stable public URL — see meta-proxy/) ─────
# Meta requires one fixed URL, but the Pinggy tunnel changes every restart.
PROXY_URL=https://your-proxy.vercel.app
PROXY_AUTH_TOKEN=change_me

# ── Authentication ───────────────────────────────────────
# HS256 signing key for session tokens. At least 32 characters.
# Generate one with: openssl rand -hex 32
# Hex, not base64: the .env parser rejects the +, / and = that base64 produces.
JWT_SECRET=

# ── Email (Resend) ───────────────────────────────────────
# https://resend.com/api-keys
# Until a domain is verified at resend.com/domains, Resend delivers only to the
# account owner's own address. Invites to anyone else are refused, and the app
# falls back to showing a copyable link.
RESEND_API_KEY=
EMAIL_FROM=EkSamadhan AI <onboarding@resend.dev>
EMAIL_ENABLED=true

# ── Frontend ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:5174

# ── Phase 2: not yet used ────────────────────────────────
# OPENAI_API_KEY=
# PINECONE_API_KEY=
# PINECONE_INDEX=
# FIREBASE_CREDENTIALS_PATH=

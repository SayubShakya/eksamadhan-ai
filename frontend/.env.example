# Sign in with Google (Firebase Authentication). Copy to frontend/.env and fill in from
# Firebase console → Project settings → General → Your apps → the web app's config.
# These identify the Firebase project to the browser; they are public by design (they end up
# in the page either way) and are not secrets. Leave blank to hide the Google button.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
